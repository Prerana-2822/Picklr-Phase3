@model Picklr.Models.PicklProgram

@{
    ViewData["Title"] = "Delete Program";
}

<h2 class="mt-3">Delete Program</h2>

<div class="alert alert-warning mt-3" style="max-width:600px;">

    <h5>Confirm Deletion</h5>

    <p>
        Are you sure you want to delete
        <strong>@Model.Name</strong>?
    </p>

    <ul class="mb-0">
        <li>
            <strong>Club:</strong>
            @Model.Club?.Name
        </li>

        <li>
            <strong>Available Days:</strong>
            @Model.AvailableDays
        </li>

        <li>
            <strong>Fee:</strong>
            @Model.Fee.ToString("C")
        </li>
    </ul>

</div>

<form asp-area="Admin"
      asp-controller="Program"
      asp-action="Delete"
      method="post">

    <input asp-for="ProgramID"
           type="hidden" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-area="Admin"
       asp-controller="Program"
       asp-action="Index"
       class="btn btn-secondary ms-2">
        Cancel
    </a>

</form>