@model Picklr.Models.PicklProgram

@{
    ViewData["Title"] = ViewBag.Action + " Program";
}

<h2 class="mt-3">
    @ViewBag.Action Program
</h2>

<form asp-area="Admin"
      asp-controller="Program"
      asp-action="AddEdit"
      method="post"
      class="mt-3"
      style="max-width:700px;">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <input asp-for="ProgramID" type="hidden" />

    <!-- Name -->
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name" class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <!-- Description -->
    <div class="mb-3">
        <label asp-for="Description"
               class="form-label"></label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="3"></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <!-- Fee -->
    <div class="mb-3">

        <label asp-for="Fee"
               class="form-label"></label>

        <div class="input-group">

            <span class="input-group-text">$</span>

            <input asp-for="Fee"
                   class="form-control" />

        </div>

        <span asp-validation-for="Fee"
              class="text-danger"></span>

    </div>

    <!-- Club -->
    <div class="mb-3">

        <label asp-for="ClubID"
               class="form-label"></label>

        <select asp-for="ClubID"
                asp-items="ViewBag.Clubs"
                class="form-select">

            <option value="">-- Select Club --</option>

        </select>

        <span asp-validation-for="ClubID"
              class="text-danger"></span>

    </div>

    <!-- Available Days -->
    <div class="mb-3">

        <label class="form-label">
            Available Days
        </label>

        <div class="row">

            <div class="col-md-3">
                <input asp-for="Monday" class="form-check-input" />
                <label asp-for="Monday"></label>
            </div>

            <div class="col-md-3">
                <input asp-for="Tuesday" class="form-check-input" />
                <label asp-for="Tuesday"></label>
            </div>

            <div class="col-md-3">
                <input asp-for="Wednesday" class="form-check-input" />
                <label asp-for="Wednesday"></label>
            </div>

            <div class="col-md-3">
                <input asp-for="Thursday" class="form-check-input" />
                <label asp-for="Thursday"></label>
            </div>

            <div class="col-md-3 mt-2">
                <input asp-for="Friday" class="form-check-input" />
                <label asp-for="Friday"></label>
            </div>

            <div class="col-md-3 mt-2">
                <input asp-for="Saturday" class="form-check-input" />
                <label asp-for="Saturday"></label>
            </div>

            <div class="col-md-3 mt-2">
                <input asp-for="Sunday" class="form-check-input" />
                <label asp-for="Sunday"></label>
            </div>

        </div>

        <span asp-validation-for="ValidateDays"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        @ViewBag.Action
    </button>

    <a asp-area="Admin"
       asp-controller="Program"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
@section scripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/atleastoneday.js"></script>
}